# ============================================================
#  FIVEM MOD FOUNDRY — konfiguracja (.env)
#  Skopiuj ten plik jako ".env" i uzupełnij wartości.
#  NIGDY nie wrzucaj pliku .env do repozytorium GitHub!
# ============================================================

# ------------------------------------------------------------
# 1) DISCORD (WYMAGANE)
# ------------------------------------------------------------
# Discord Developer Portal -> Twoja aplikacja -> Bot -> Reset Token
DISCORD_TOKEN=OTI4MDQ5NTUwMDM0MzM3OTAz.GfAB-D.jgVLsXM4iKwnlnWLtGctk3JSfi07qmuJ04uIzU
# Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=928049550034337903

# ------------------------------------------------------------
# 2) YOUTUBE DATA API v3 (live feed najnowszych modów)
# ------------------------------------------------------------
# console.cloud.google.com -> nowy projekt -> włącz "YouTube Data API v3"
# -> Credentials -> Create credentials -> API key
YOUTUBE_API_KEY=wklej_tutaj_klucz_youtube

# ------------------------------------------------------------
# 3) SERWER HTTP (linki do paczek ZIP i podglądów)
# ------------------------------------------------------------
HTTP_PORT=3000
# Publiczny adres bota — BEZ tego linki wskazują localhost i gracze
# NIE pobiorą paczek! Przykłady:
#   VPS:            http://123.123.123.123:3000
#   domena:         https://bot.twojadomena.pl   (reverse proxy, zalecane)
#   Render:         https://fivem-citizen-bot.onrender.com
PUBLIC_URL=

# ------------------------------------------------------------
# 4) WERSJA GRY (wersjonowanie paczek)
# ------------------------------------------------------------
# Docelowy build GTA V zapisywany w każdej paczce (manifest.json).
# Zmiana tej wartości (albo komenda /build) powiadomi kanał modów,
# że wcześniejsze paczki wymagają regeneracji.
# Dostępne: latest | 3411 | 3258 | 3095 | 2944
GAME_BUILD=latest

# ------------------------------------------------------------
# 5) WYSZUKIWARKA SKINÓW (.rpf)
# ------------------------------------------------------------
# Adres zewnętrznego indeksu skinów (JSON). Format:
# [{"id":"ak-redline","name":"AK-47 Redline","description":"...",
#   "imageUrl":"https://...","fileUrl":"https://.../ak.rpf",
#   "author":"...","tags":["ak47","red"]}]
# UWAGA: przyjmowane są TYLKO pliki z końcówką .rpf.
SKIN_INDEX_URL=https://raw.githubusercontent.com/twoj-user/fivem-skin-index/main/skins.json

# ------------------------------------------------------------
# 6) LIMITY I WYDAJNOŚĆ (opcjonalne — są sensowne domyślne)
# ------------------------------------------------------------
# Interwał skanera YouTube w minutach
YT_SCAN_MINUTES=15
# Ile paczek ZIP pakuje się równolegle (chroni serwer przed przeciążeniem)
ZIP_QUEUE_CONCURRENCY=2
# Czas życia linku do paczki ZIP w minutach
DOWNLOAD_TTL_MINUTES=60
# Czas życia sesji kreatora bezczynności w minutach
SESSION_TTL_MINUTES=120
# Auto-zamknięcie kanału po wygenerowaniu paczki (minuty)
CHANNEL_CLEANUP_MINUTES=15
# Limit pojedynczego pobieranego pliku w MB
MAX_DOWNLOAD_MB=200
# Czas życia zgłoszeń bezpieczeństwa (pliki .asi/.zip do akceptacji admina)
APPROVAL_TTL_MINUTES=1440
