# === TOKEN BOTA ===
# https://discord.com/developers/applications -> Twoja aplikacja -> Bot -> Reset Token
DISCORD_TOKEN=wklej_tutaj_token_bota

# === ID APLIKACJI (Client ID) ===
# https://discord.com/developers/applications -> Twoja aplikacja -> OAuth2 -> Client ID
CLIENT_ID=wklej_tutaj_client_id

# === SERWER HTTP (linki do pobierania paczek) ===
HTTP_PORT=3000
# Publiczny adres bota (np. na Render/Railway):
# PUBLIC_URL=https://twoj-bot.onrender.com
PUBLIC_URL=
